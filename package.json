{
  "name": "window-color",
  "displayName": "Unique Window Colors",
  "description": "Color-code your projects.",
  "version": "0.0.2",
  "publisher": "n1kk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n1kk/vscode-window-color-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "windowColor.pick",
        "title": "Set Window Color…",
        "category": "Window Color"
      },
      {
        "command": "windowColor.clear",
        "title": "Clear Window Color",
        "category": "Window Color"
      },
      {
        "command": "windowColor.setColor",
        "title": "Set Window Color to a Given Hex",
        "category": "Window Color"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "windowColor.setColor",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Window Color",
      "properties": {
        "windowColor.themeColors": {
          "type": "object",
          "default": null,
          "markdownDescription": "The matched pair of colors, written by the picker. The color for the theme kind you are not currently using cannot be recovered from `#workbench.colorCustomizations#`, so it is kept here. Absent when one color is used under every theme.",
          "properties": {
            "dark": {
              "type": "string",
              "description": "Color used under dark and high-contrast themes.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "light": {
              "type": "string",
              "description": "Color used under light themes.",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "pnpm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit && tsc -p src/webview --noEmit",
    "vscode:prepublish": "pnpm run package",
    "vsix": "node scripts/package.js",
    "vsix:dev": "node scripts/package.js --dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
