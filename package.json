{
  "name": "window-color",
  "displayName": "Unique Window Colors",
  "description": "Color-code your projects.",
  "version": "0.0.2",
  "publisher": "n1kk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n1kk/vscode-window-color-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "windowColor.pick",
        "title": "Set Window Color…",
        "category": "Window Color"
      },
      {
        "command": "windowColor.clear",
        "title": "Clear Window Color",
        "category": "Window Color"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "pnpm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "pnpm run package",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
